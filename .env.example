# ---------------------------------------------------------------------------
# Amazon India Product Research MCP - environment configuration
# Copy to .env and edit. Never commit the real .env file.
# ---------------------------------------------------------------------------

# --- General ---------------------------------------------------------------
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO

# --- Database --------------------------------------------------------------
# SQLite for development; any PostgreSQL URL also works, e.g.
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/amazon_mcp
DATABASE_URL=sqlite:///./amazon_product_mcp.db
DB_ECHO=false
PERSIST_RESEARCH=true

# --- Amazon credentials (SP-API / Product Advertising API) -----------------
# Leave blank to stay in demo mode. Never commit real credentials.
AMAZON_API_KEY=
AMAZON_API_SECRET=
AMAZON_MARKETPLACE=amazon.in

# --- Third party product data provider -------------------------------------
# demo | sp-api | pa-api | <name of an approved third-party data API>
PRODUCT_DATA_PROVIDER=demo
PRODUCT_DATA_API_KEY=
PRODUCT_DATA_BASE_URL=

# --- Trends ----------------------------------------------------------------
# No live trends provider ships with this project; when enabled without one,
# results stay on the internal estimation model and say so in the notes.
GOOGLE_TRENDS_ENABLED=false

# --- Suppliers -------------------------------------------------------------
# Without these, search_suppliers returns public sourcing channels only and
# never invents supplier records.
SUPPLIER_API_KEY=
SUPPLIER_API_BASE_URL=

# --- Behaviour -------------------------------------------------------------
# DEMO_MODE=true uses deterministic sample data labelled "Demo".
DEMO_MODE=true
CACHE_ENABLED=true
CACHE_TTL_SECONDS=900
HTTP_TIMEOUT_SECONDS=20

# --- Amazon fee schedule ---------------------------------------------------
# Optional path to a JSON file with your Seller Central rate card. When unset,
# the bundled approximate schedule (data_type="Estimated") is used.
AMAZON_FEE_CONFIG_PATH=
