# ---------------------------------------------------------------------------
# Amazon India Product Research MCP - environment configuration
#
# Copy to .env and edit:   cp .env.example .env   (Windows: copy .env.example .env)
# .env is gitignored. NEVER commit real credentials.
#
# Two ready-made profiles are at the bottom of this file:
#   A) DEMO      - everything works offline, no keys, all data labelled "Demo"
#   B) PRODUCTION - real live data using only FREE, no-API-key sources
# ---------------------------------------------------------------------------

# --- General ---------------------------------------------------------------
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO

# --- Database --------------------------------------------------------------
# SQLite for development; any PostgreSQL URL also works, e.g.
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/amazon_mcp
DATABASE_URL=sqlite:///./amazon_product_mcp.db
DB_ECHO=false
PERSIST_RESEARCH=true

# --- Data mode -------------------------------------------------------------
# true  = deterministic sample data, clearly labelled "Demo" (no keys needed)
# false = use the configured live provider below
DEMO_MODE=true

# --- Product data provider -------------------------------------------------
# demo    - offline sample data
# scraper - live amazon.in public pages (FREE, no API key; see docs/SCRAPING.md)
# sp-api / pa-api - not implemented yet; raises a clear error rather than faking data
# <name>  - an approved third-party data API via PRODUCT_DATA_BASE_URL
PRODUCT_DATA_PROVIDER=demo
PRODUCT_DATA_API_KEY=
PRODUCT_DATA_BASE_URL=

# --- Amazon credentials (SP-API / Product Advertising API) -----------------
AMAZON_API_KEY=
AMAZON_API_SECRET=
AMAZON_MARKETPLACE=amazon.in

# --- Google Trends (FREE, no API key) --------------------------------------
# Real search-interest data for India. Powers demand, seasonality and the
# evergreen score. Needs: uv sync --extra realtime
GOOGLE_TRENDS_ENABLED=false

# --- Web search ------------------------------------------------------------
# duckduckgo - FREE, no API key (needs: uv sync --extra realtime)
# brave | serper | tavily | google_cse - free tiers, API key required
# demo - offline placeholder results
WEB_SEARCH_PROVIDER=demo
WEB_SEARCH_API_KEY=
WEB_SEARCH_BASE_URL=
WEB_SEARCH_CX=

# --- Browser / scraping layer ----------------------------------------------
# Off by default. Read docs/SCRAPING.md before switching this on: robots.txt is
# enforced, rate limits are enforced, and bot-protection bypass is NOT
# implemented. You are responsible for your right to access each domain.
BROWSER_ENABLED=false
BROWSER_ALLOWED_DOMAINS=
BROWSER_RESPECT_ROBOTS=true
BROWSER_MIN_DELAY_SECONDS=5
BROWSER_MAX_PAGES_PER_RUN=20
BROWSER_HEADLESS=true
BROWSER_TIMEOUT_SECONDS=30
# Identify yourself honestly; blank uses a standard Chromium user agent.
BROWSER_USER_AGENT=
# Optional JSON file of CSS selectors per domain, to fix parsing without code changes.
BROWSER_SELECTORS_PATH=

# --- Suppliers -------------------------------------------------------------
# Without these, search_suppliers returns public sourcing channels only and
# never invents supplier records.
SUPPLIER_API_KEY=
SUPPLIER_API_BASE_URL=

# --- Sales and competitor thresholds ---------------------------------------
# A competitor must clear this monthly volume to count as a real seller.
MIN_MONTHLY_UNITS_TARGET=300
# At or below this review count, a competitor is treated as a new seller.
NEW_SELLER_REVIEW_THRESHOLD=50
NEW_SELLER_AGE_MONTHS=6

# --- Performance -----------------------------------------------------------
CACHE_ENABLED=true
CACHE_TTL_SECONDS=900
HTTP_TIMEOUT_SECONDS=20

# --- Amazon fee schedule ---------------------------------------------------
# Optional path to a JSON file holding your Seller Central rate card. When
# unset, the bundled approximate schedule (data_type="Estimated") is used.
# Setting this is the single biggest accuracy win and costs nothing.
AMAZON_FEE_CONFIG_PATH=


# ===========================================================================
# PROFILE A - DEMO (default above). No keys, no network, everything labelled
# "Demo". Best for learning the tools and running the test suite.
# ===========================================================================

# ===========================================================================
# PROFILE B - PRODUCTION on FREE sources only. No API keys anywhere.
# Run `uv sync --extra realtime --extra browser` first, then replace the
# values above with these:
#
#   APP_ENV=production
#   DEMO_MODE=false
#   PRODUCT_DATA_PROVIDER=scraper
#   GOOGLE_TRENDS_ENABLED=true
#   WEB_SEARCH_PROVIDER=duckduckgo
#   BROWSER_ENABLED=true
#   BROWSER_ALLOWED_DOMAINS=amazon.in
#   BROWSER_RESPECT_ROBOTS=true
#   BROWSER_MIN_DELAY_SECONDS=8
#
# What you get for free: live Google Trends demand and seasonality, live web
# search, and live amazon.in prices, ASINs and "bought in past month" badges.
#
# What you must know: Amazon serves bot challenges to automated traffic. This
# server detects them and stops - it does not bypass them - so scraping works
# intermittently. For reliable Amazon data at scale, use a licensed API
# (Rainforest, Keepa, SP-API). See docs/SCRAPING.md.
# ===========================================================================
